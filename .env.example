APP_NAME="Kashmir College of Engineering & Technology"
APP_SHORT_NAME="KCET"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/kcet/public

# Database Configuration (supports 'sqlite' or 'mysql')
DB_CONNECTION=sqlite
DB_FILE=storage/database.sqlite

# MySQL settings (used when DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kcet_db
DB_USERNAME=root
DB_PASSWORD=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@kcet.edu.in"
MAIL_FROM_NAME="KCET Admissions"

# Session settings
ADMIN_SESSION_LIFETIME=7200

